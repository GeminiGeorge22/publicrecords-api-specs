{
  "openapi": "3.0.3",
  "info": {
    "title": "Sports Odds API: BetRivers, Unibet, Paf, Svenska Spel, ATG",
    "version": "1.0.0",
    "description": "Live sports odds from every open Kambi-powered sportsbook in one call. You get one row per game with each book's price for every outcome and the best price across the books you chose.\n\nMore: https://apify.com/publicrecords/sports-odds-api"
  },
  "servers": [
    {
      "url": "https://publicrecords-api-gateway.publicrecords.workers.dev"
    }
  ],
  "components": {
    "schemas": {
      "Input": {
        "title": "Kambi sportsbook odds",
        "type": "object",
        "properties": {
          "leagues": {
            "title": "Leagues or sports",
            "type": "array",
            "description": "Kambi paths, sport or league level: \"basketball/nba\", \"american_football/nfl\", \"ice_hockey/nhl\", \"baseball/mlb\", \"football/england/premier_league\", or a whole sport such as \"tennis\". Unknown paths are answered with suggestions and are never charged.",
            "default": [
              "basketball/nba",
              "american_football/nfl",
              "ice_hockey/nhl",
              "baseball/mlb",
              "football/england/premier_league"
            ]
          },
          "operators": {
            "title": "Sportsbooks",
            "type": "array",
            "description": "Kambi-powered books to price. Each book is a separate brand/jurisdiction feed; prices can differ between them. The list contains only books verified open on the date in the README.",
            "items": {
              "type": "string",
              "enum": [
                "rsiusnj",
                "rsiusny",
                "rsiuspa",
                "rsiusil",
                "rsiusin",
                "rsiusco",
                "rsiusmi",
                "rsiusaz",
                "rsiusla",
                "rsiusmd",
                "rsiusoh",
                "rsiuswv",
                "rsicaon",
                "ubuk",
                "ubca",
                "ubse",
                "ubdk",
                "ubbe",
                "ubnl",
                "ubro",
                "paf",
                "pafes",
                "svenskaspel",
                "atg"
              ],
              "x-enumTitles": [
                "BetRivers \u2014 US-NJ (rsiusnj)",
                "BetRivers \u2014 US-NY (rsiusny)",
                "BetRivers \u2014 US-PA (rsiuspa)",
                "BetRivers \u2014 US-IL (rsiusil)",
                "BetRivers \u2014 US-IN (rsiusin)",
                "BetRivers \u2014 US-CO (rsiusco)",
                "BetRivers \u2014 US-MI (rsiusmi)",
                "BetRivers \u2014 US-AZ (rsiusaz)",
                "BetRivers \u2014 US-LA (rsiusla)",
                "BetRivers \u2014 US-MD (rsiusmd)",
                "BetRivers \u2014 US-OH (rsiusoh)",
                "BetRivers \u2014 US-WV (rsiuswv)",
                "BetRivers \u2014 CA-ON (rsicaon)",
                "Unibet \u2014 GB (ubuk)",
                "Unibet \u2014 CA-ON (ubca)",
                "Unibet \u2014 SE (ubse)",
                "Unibet \u2014 DK (ubdk)",
                "Unibet \u2014 BE (ubbe)",
                "Unibet \u2014 NL (ubnl)",
                "Unibet \u2014 RO (ubro)",
                "Paf \u2014 FI (paf)",
                "Paf \u2014 ES (pafes)",
                "Svenska Spel \u2014 SE (svenskaspel)",
                "ATG \u2014 SE (atg)"
              ]
            },
            "default": [
              "rsiusnj",
              "rsiusny",
              "rsiuspa",
              "rsicaon",
              "ubuk",
              "ubca",
              "paf",
              "svenskaspel",
              "atg"
            ]
          },
          "markets": {
            "title": "Markets",
            "type": "string",
            "enum": [
              "main",
              "all"
            ],
            "x-enumTitles": [
              "Main lines (moneyline, spread, total)",
              "Every market incl. player props and alternates"
            ],
            "description": "\"main\" returns the headline markets per game. \"all\" returns each game's full board (often 300\u2013500 markets) and is priced higher.",
            "default": "main"
          },
          "includeLive": {
            "title": "Include in-play games",
            "type": "boolean",
            "description": "Include games already started (live prices at the moment of the run).",
            "default": true
          },
          "startsWithinHours": {
            "title": "Only games starting within (hours)",
            "type": "integer",
            "minimum": 0,
            "description": "0 = no limit. Live games are kept when \"Include in-play games\" is on.",
            "default": 0
          },
          "maxEvents": {
            "title": "Max games",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Soonest games first. You pay per game returned.",
            "default": 50
          },
          "proxyConfiguration": {
            "title": "Proxy (optional)",
            "type": "object",
            "description": "On by default. Kambi limits how often one IP may ask; your run moves to a fresh Apify Proxy IP whenever it is slowed down. Turn off only to test without a proxy.",
            "default": {}
          }
        }
      }
    }
  },
  "paths": {
    "/v1/sports-odds-api": {
      "post": {
        "operationId": "run_sports_odds_api",
        "summary": "Run Sports Odds API: BetRivers, Unibet, Paf, Svenska Spel, ATG",
        "description": "Runs the job and returns the result rows as JSON (waits up to 280 s).",
        "parameters": [
          {
            "name": "maxItems",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "leagues": [
                  "basketball/nba",
                  "american_football/nfl",
                  "ice_hockey/nhl",
                  "baseball/mlb",
                  "football/england/premier_league"
                ],
                "maxEvents": 10,
                "proxyConfiguration": {
                  "useApifyProxy": true
                },
                "operators": [
                  "rsiusnj",
                  "rsiusny",
                  "rsiuspa",
                  "rsicaon",
                  "ubuk",
                  "ubca",
                  "paf",
                  "svenskaspel",
                  "atg"
                ],
                "markets": "main",
                "includeLive": true,
                "startsWithinHours": 0
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Result rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad input"
          }
        }
      }
    }
  }
}
