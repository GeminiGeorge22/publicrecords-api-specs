{
  "openapi": "3.0.3",
  "info": {
    "title": "Etsy Shop Sales Tracker & Scraper",
    "version": "0.2.41",
    "description": "Track total sales of 200,000+ Etsy shops: sales counts with the date read and 7-day changes. Research competitor shops side by side. Pay per shop.\n\nRuns the Apify Actor publicrecords/etsy-shop-velocity (https://apify.com/publicrecords/etsy-shop-velocity) on the caller's own Apify account. Authenticate with your own Apify API token (Bearer). Billing, if any, is shown on the Store page.",
    "contact": {
      "name": "publicrecords",
      "url": "https://apify.com/publicrecords/etsy-shop-velocity"
    },
    "license": {
      "name": "MIT"
    }
  },
  "externalDocs": {
    "url": "https://apify.com/publicrecords/etsy-shop-velocity"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2"
    }
  ],
  "security": [
    {
      "apifyToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apifyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your own Apify API token (Apify Console > Settings > API & Integrations)."
      }
    },
    "schemas": {
      "Input": {
        "title": "Etsy Shop Sales Velocity input",
        "type": "object",
        "properties": {
          "shops": {
            "title": "Shop names",
            "type": "array",
            "description": "Etsy shop names (the part after etsy.com/shop/). Leave empty to use the keyword or category filters."
          },
          "keywords": {
            "title": "Keywords in shop title",
            "type": "array",
            "description": "Case-insensitive words matched against the shop title and headline."
          },
          "category": {
            "title": "Panel category",
            "type": "string",
            "description": "Exact panel category label, matched case-insensitively, e.g. \"kids & baby > toys\", \"home & living > home decor > scatter cushions\", \"art & collectibles > fine art ceramics\". The label is filled for about 0.7% of shops, so a category filter returns only those shops. Empty = all."
          },
          "minSales": {
            "title": "Minimum lifetime sales",
            "type": "integer",
            "description": "Only shops at or above this sales counter.",
            "minimum": 0,
            "default": 0
          },
          "since": {
            "title": "Changed since (date)",
            "type": "string",
            "description": "ISO date. Return only shops whose counters changed since this date. Empty = all matching shops."
          },
          "maxShops": {
            "title": "Max shops",
            "type": "integer",
            "description": "Upper bound on rows returned (and charged).",
            "minimum": 1,
            "maximum": 20000,
            "default": 200
          }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "defaultDatasetId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/acts/publicrecords~etsy-shop-velocity/run-sync-get-dataset-items": {
      "post": {
        "operationId": "runSync_etsy_shop_velocity",
        "summary": "Run Etsy Shop Sales Tracker & Scraper and return results",
        "description": "Starts a run, waits for it to finish (up to 300 s) and returns the dataset items.",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "name": "maxItems",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "shops": [
                  "OrelCeramics",
                  "Bestickend"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~etsy-shop-velocity/runs": {
      "post": {
        "operationId": "runAsync_etsy_shop_velocity",
        "summary": "Start Etsy Shop Sales Tracker & Scraper (async)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "shops": [
                  "OrelCeramics",
                  "Bestickend"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/actor-runs/{runId}": {
      "get": {
        "operationId": "getRun_etsy_shop_velocity",
        "summary": "Get run status",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/items": {
      "get": {
        "operationId": "getItems_etsy_shop_velocity",
        "summary": "Get run results",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xlsx"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items"
          }
        }
      }
    }
  }
}
