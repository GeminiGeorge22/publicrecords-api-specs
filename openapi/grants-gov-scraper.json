{
  "openapi": "3.0.3",
  "info": {
    "title": "Grants.gov Search API: federal grants list with deadlines",
    "version": "0.0.15",
    "description": "Which federal grants are open right now? Searches Grants.gov and returns opportunity, agency, deadline, eligibility and the source link.\n\nRuns the Apify Actor publicrecords/grants-gov-scraper (https://apify.com/publicrecords/grants-gov-scraper) on the caller's own Apify account. Authenticate with your own Apify API token (Bearer). Billing, if any, is shown on the Store page.",
    "contact": {
      "name": "publicrecords",
      "url": "https://apify.com/publicrecords/grants-gov-scraper"
    },
    "license": {
      "name": "MIT"
    }
  },
  "externalDocs": {
    "url": "https://apify.com/publicrecords/grants-gov-scraper"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2"
    }
  ],
  "security": [
    {
      "apifyToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apifyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your own Apify API token (Apify Console > Settings > API & Integrations)."
      }
    },
    "schemas": {
      "Input": {
        "title": "Grants.gov Opportunities Scraper",
        "description": "Public Grants.gov search2 API. No API key. Response token/accessKey are ignored. Server date filter: postedWithinDays \u2192 dateRange. open/close date fields are client-side (API does not support custom MM/DD ranges).",
        "type": "object",
        "properties": {
          "keyword": {
            "title": "Keyword",
            "type": "string",
            "description": "Search keyword (e.g. education, cybersecurity). Leave empty for all.",
            "default": ""
          },
          "agency": {
            "title": "Agency",
            "type": "string",
            "description": "Mapped to API body agencies (e.g. HHS, EPA, NSF).",
            "default": "",
            "nullable": true
          },
          "status": {
            "title": "Opportunity status",
            "type": "string",
            "description": "Mapped to API oppStatuses. Use forecasted|posted|closed|archived or pipe-joined.",
            "default": "forecasted|posted"
          },
          "postedWithinDays": {
            "title": "Posted within N days",
            "type": "integer",
            "description": "Server-side filter mapped to search2 dateRange (posted-date lookback). Verified values: 3,7,14,21,28,35,42,49,56,90,180,365. Omit for no posted-date filter.",
            "minimum": 1,
            "maximum": 3650,
            "nullable": true
          },
          "openDateFrom": {
            "title": "Open date from",
            "type": "string",
            "description": "Client-side filter on openDate. Accepts MM/DD/YYYY or YYYY-MM-DD. Inclusive.",
            "nullable": true
          },
          "openDateTo": {
            "title": "Open date to",
            "type": "string",
            "description": "Client-side filter on openDate. Inclusive.",
            "nullable": true
          },
          "closeDateFrom": {
            "title": "Close date from",
            "type": "string",
            "description": "Client-side filter on closeDate. Inclusive. Useful for 'still open' windows.",
            "nullable": true
          },
          "closeDateTo": {
            "title": "Close date to",
            "type": "string",
            "description": "Client-side filter on closeDate. Inclusive.",
            "nullable": true
          },
          "maxItems": {
            "title": "Max items",
            "type": "integer",
            "description": "Cap on opportunity rows (deduped by opportunityId).",
            "default": 50,
            "minimum": 1,
            "maximum": 5000
          },
          "fetchDetails": {
            "title": "Fetch opportunity details",
            "type": "boolean",
            "description": "Hydrate synopsis via fetchOpportunity. Still one PPE charge per opportunity.",
            "default": false
          }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "defaultDatasetId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/acts/publicrecords~grants-gov-scraper/run-sync-get-dataset-items": {
      "post": {
        "operationId": "runSync_grants_gov_scraper",
        "summary": "Run Grants.gov Search API: federal grants list with deadlines and return results",
        "description": "Starts a run, waits for it to finish (up to 300 s) and returns the dataset items.",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "name": "maxItems",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "status": "posted",
                "maxItems": 200
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~grants-gov-scraper/runs": {
      "post": {
        "operationId": "runAsync_grants_gov_scraper",
        "summary": "Start Grants.gov Search API: federal grants list with deadlines (async)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "status": "posted",
                "maxItems": 200
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/actor-runs/{runId}": {
      "get": {
        "operationId": "getRun_grants_gov_scraper",
        "summary": "Get run status",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/items": {
      "get": {
        "operationId": "getItems_grants_gov_scraper",
        "summary": "Get run results",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xlsx"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items"
          }
        }
      }
    }
  }
}
