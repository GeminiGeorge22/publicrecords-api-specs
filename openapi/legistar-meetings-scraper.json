{
  "openapi": "3.0.3",
  "info": {
    "title": "Legistar City Council Minutes & Agendas: meetings, items",
    "version": "0.0.13",
    "description": "What did a city council decide? Returns Legistar meetings, agenda items, votes and documents for any city on Legistar, with the source link.\n\nRuns the Apify Actor publicrecords/legistar-meetings-scraper (https://apify.com/publicrecords/legistar-meetings-scraper) on the caller's own Apify account. Authenticate with your own Apify API token (Bearer). Billing, if any, is shown on the Store page.",
    "contact": {
      "name": "publicrecords",
      "url": "https://apify.com/publicrecords/legistar-meetings-scraper"
    },
    "license": {
      "name": "MIT"
    }
  },
  "externalDocs": {
    "url": "https://apify.com/publicrecords/legistar-meetings-scraper"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2"
    }
  ],
  "security": [
    {
      "apifyToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apifyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your own Apify API token (Apify Console > Settings > API & Integrations)."
      }
    },
    "schemas": {
      "Input": {
        "title": "Legistar Meetings Scraper",
        "description": "Public Granicus Legistar Web API. Client slug is the first label of {slug}.legistar.com (e.g. seattle). chicago currently 500s; phila 403s.",
        "type": "object",
        "properties": {
          "clients": {
            "title": "Client slugs",
            "type": "array",
            "description": "Legistar client codes. Use the hostname label of {slug}.legistar.com. Working examples: seattle, milwaukee, madison, oakland, sanjose, boston, denver, columbus.",
            "default": [
              "seattle"
            ]
          },
          "dateFrom": {
            "title": "From date",
            "type": "string",
            "description": "Inclusive YYYY-MM-DD (EventDate / MatterIntroDate). Default: 30 days ago.",
            "nullable": true
          },
          "dateTo": {
            "title": "To date",
            "type": "string",
            "description": "Inclusive YYYY-MM-DD. Default: today + 14 days.",
            "nullable": true
          },
          "maxItems": {
            "title": "Max items",
            "type": "integer",
            "description": "Cap on dataset rows (events + matters combined).",
            "default": 50,
            "minimum": 1,
            "maximum": 5000
          },
          "resource": {
            "title": "Resource",
            "type": "string",
            "description": "Which Legistar collection to pull.",
            "enum": [
              "events",
              "matters",
              "both"
            ],
            "x-enumTitles": [
              "Meetings (events)",
              "Matters (legislation)",
              "Both"
            ],
            "default": "events"
          },
          "includeEventItems": {
            "title": "Include agenda item titles",
            "type": "boolean",
            "description": "Extra HTTP call per event. Titles flattened into eventItemTitles (pipe-separated). Default off.",
            "default": false
          }
        },
        "required": [
          "clients"
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "defaultDatasetId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/acts/publicrecords~legistar-meetings-scraper/run-sync-get-dataset-items": {
      "post": {
        "operationId": "runSync_legistar_meetings_scraper",
        "summary": "Run Legistar City Council Minutes & Agendas: meetings, items and return results",
        "description": "Starts a run, waits for it to finish (up to 300 s) and returns the dataset items.",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "name": "maxItems",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "clients": [
                  "seattle",
                  "milwaukee",
                  "madison",
                  "oakland",
                  "sanjose",
                  "boston",
                  "denver",
                  "columbus"
                ],
                "dateFrom": "2026-09-20",
                "dateTo": "2026-09-28",
                "maxItems": 200,
                "resource": "events"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~legistar-meetings-scraper/runs": {
      "post": {
        "operationId": "runAsync_legistar_meetings_scraper",
        "summary": "Start Legistar City Council Minutes & Agendas: meetings, items (async)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "clients": [
                  "seattle",
                  "milwaukee",
                  "madison",
                  "oakland",
                  "sanjose",
                  "boston",
                  "denver",
                  "columbus"
                ],
                "dateFrom": "2026-09-20",
                "dateTo": "2026-09-28",
                "maxItems": 200,
                "resource": "events"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/actor-runs/{runId}": {
      "get": {
        "operationId": "getRun_legistar_meetings_scraper",
        "summary": "Get run status",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/items": {
      "get": {
        "operationId": "getItems_legistar_meetings_scraper",
        "summary": "Get run results",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xlsx"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items"
          }
        }
      }
    }
  }
}
