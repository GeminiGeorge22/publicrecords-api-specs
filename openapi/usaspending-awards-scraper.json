{
  "openapi": "3.0.3",
  "info": {
    "title": "USAspending API Awards: federal contract and grant awards",
    "version": "0.0.20",
    "description": "Who won federal contracts and grants, and for how much? Pulls USAspending awards by agency, recipient, NAICS and period, with award IDs and source links.\n\nRuns the Apify Actor publicrecords/usaspending-awards-scraper (https://apify.com/publicrecords/usaspending-awards-scraper) on the caller's own Apify account. Authenticate with your own Apify API token (Bearer). Billing, if any, is shown on the Store page.",
    "contact": {
      "name": "publicrecords",
      "url": "https://apify.com/publicrecords/usaspending-awards-scraper"
    },
    "license": {
      "name": "MIT"
    }
  },
  "externalDocs": {
    "url": "https://apify.com/publicrecords/usaspending-awards-scraper"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2"
    }
  ],
  "security": [
    {
      "apifyToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apifyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your own Apify API token (Apify Console > Settings > API & Integrations)."
      }
    },
    "schemas": {
      "Input": {
        "title": "USASpending Awards Scraper",
        "description": "Public USASpending.gov spending_by_award API. Defaults to recent contracts/IDVs (A\u2013D) over the last 30 days. Emphasize agency / recipient / date filters.",
        "type": "object",
        "properties": {
          "keywords": {
            "title": "Keywords",
            "type": "array",
            "description": "Mapped to filters.keywords. Leave empty for broad recent awards; prefer agency/recipient/date.",
            "default": []
          },
          "naics": {
            "title": "NAICS codes",
            "type": "array",
            "description": "Mapped to filters.naics_codes.",
            "default": []
          },
          "agency": {
            "title": "Awarding agency (toptier name)",
            "type": "string",
            "description": "Toptier awarding agency name \u2192 filters.agencies[{type:awarding,tier:toptier,name}]. Example: Department of Defense.",
            "default": "",
            "nullable": true
          },
          "recipient": {
            "title": "Recipient name",
            "type": "string",
            "description": "Mapped to filters.recipient_search_text (array). Example: Boeing. Verified shape requires an array of strings.",
            "default": "",
            "nullable": true
          },
          "awardTypes": {
            "title": "Award type codes",
            "type": "array",
            "description": "Default A,B,C,D (contracts/IDVs). Avoid assistance codes that may list individuals.",
            "default": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "startDate": {
            "title": "Start date",
            "type": "string",
            "description": "YYYY-MM-DD. Default: today \u2212 30 days (recent awards window).",
            "nullable": true
          },
          "endDate": {
            "title": "End date",
            "type": "string",
            "description": "YYYY-MM-DD. Default: today.",
            "nullable": true
          },
          "subawards": {
            "title": "Subawards mode",
            "type": "boolean",
            "description": "Pass subawards flag to search (default false).",
            "default": false
          },
          "fetchDetails": {
            "title": "Fetch award details",
            "type": "boolean",
            "description": "Hydrate via GET /awards/{generated_internal_id}/. Still one PPE charge.",
            "default": false
          },
          "maxItems": {
            "title": "Max items",
            "type": "integer",
            "description": "Cap on award rows (deduped by awardId|generatedInternalId).",
            "default": 50,
            "minimum": 1,
            "maximum": 5000
          }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "defaultDatasetId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/acts/publicrecords~usaspending-awards-scraper/run-sync-get-dataset-items": {
      "post": {
        "operationId": "runSync_usaspending_awards_scraper",
        "summary": "Run USAspending API Awards: federal contract and grant awards and return results",
        "description": "Starts a run, waits for it to finish (up to 300 s) and returns the dataset items.",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "name": "maxItems",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "agency": "Department of Defense",
                "awardTypes": [
                  "A",
                  "B",
                  "C",
                  "D"
                ],
                "maxItems": 50
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~usaspending-awards-scraper/runs": {
      "post": {
        "operationId": "runAsync_usaspending_awards_scraper",
        "summary": "Start USAspending API Awards: federal contract and grant awards (async)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              },
              "example": {
                "agency": "Department of Defense",
                "awardTypes": [
                  "A",
                  "B",
                  "C",
                  "D"
                ],
                "maxItems": 50
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/actor-runs/{runId}": {
      "get": {
        "operationId": "getRun_usaspending_awards_scraper",
        "summary": "Get run status",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/items": {
      "get": {
        "operationId": "getItems_usaspending_awards_scraper",
        "summary": "Get run results",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xlsx"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items"
          }
        }
      }
    }
  }
}
